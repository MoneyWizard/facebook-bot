# ==========================================
# Facebook Bot — Environment Variables
# Copy this file to .env and fill in values
# ==========================================

# OpenAI API Key (required for GPT-4o analysis)
OPENAI_API_KEY=sk-your-openai-key-here

# --- PROXY CONFIGURATION ---
# Recommended services (free tiers or affordable):
#   - Webshare.io       → https://webshare.io  (10 free residential IPs/month)
#   - Proxyscrape.com   → https://proxyscrape.com (free rotating proxies - less reliable)
#   - Bright Data       → https://brightdata.com (paid, best quality)
#   - Oxylabs           → https://oxylabs.io (paid, enterprise grade)
#
# Format: http://USERNAME:PASSWORD@HOST:PORT
# Leave blank to run without proxy (higher block risk)
PROXY_URL=

# Server
PORT=3500

# Browser
# Set to "false" to see the browser window (useful for debugging)
HEADLESS=true

# Scraping behavior
MAX_RETRIES=3
SCRAPE_DELAY_MIN=2000
SCRAPE_DELAY_MAX=6000

# Max posts to scrape per profile
MAX_POSTS=10

# Max search results pages to paginate
MAX_SEARCH_PAGES=3

# Log level: error | warn | info | debug
LOG_LEVEL=info
